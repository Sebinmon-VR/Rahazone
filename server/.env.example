# Copy to server/.env (never commit .env)

# --- Database: Azure SQL / SQL Server -------------------------------------
# Option A: one connection string (ADO style, as shown in the Azure portal)
# DATABASE_URL=Server=tcp:rahazone.database.windows.net,1433;Initial Catalog=rahazone;User ID=rahazone;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;Connection Timeout=60

# Option B: discrete settings with SQL authentication
DB_SERVER=rahazone.database.windows.net
DB_NAME=rahazone
DB_USER=rahazone
DB_PASSWORD=YOUR_PASSWORD

# Option C: Azure AD instead of a password. Locally this uses your `az login`
# session; on Azure App Service / Container Apps it uses the Managed Identity.
# DB_AUTH=aad

# --- App -----------------------------------------------------------------
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# First-run admin (only used when no admin exists yet)
ADMIN_EMAIL=admin@rahazone.com
ADMIN_PASSWORD=admin123
# Where uploaded documents are stored (defaults to server/uploads)
# UPLOAD_DIR=/home/data/uploads

# --- Document storage ----------------------------------------------------
# With a connection string set, uploads go to Azure Blob Storage under
# <container>/<prefix>/. Without it they go to UPLOAD_DIR on local disk.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=uploads
AZURE_STORAGE_PREFIX=rahazone
MAX_UPLOAD_BYTES=8388608
